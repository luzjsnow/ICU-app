{
  "name": "icu-pump-pro",
  "private": true,
  "version": "1.0.0",
  "description": "ICU 医师离线微量泵配比、走速双向换算、浓缩调泵与用药速查工具（支持 Android APK 与 iOS Scriptable）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:single": "tsc -b && vite build --config vite.config.singlefile.ts",
    "build:scriptable": "npm run build:single && node scripts/build-scriptable.mjs",
    "build:qr": "node scripts/generate-qrcodes.mjs",
    "build:all": "npm run build && npm run build:scriptable && npm run build:qr",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^0.469.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@tailwindcss/vite": "^4.0.9",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-singlefile": "^2.2.0",
    "vitest": "^3.0.5"
  }
}
